; ---- settings, dashboard, clock, info, sleep, pending ---------------------------------------------------
app_sleep:
    jp S_POWER_SLEEP

; ---- settings -----------------------------------------------------------------------------------------
SET_ROWS    .equ 7

app_settings:
    xor a
    ld (v_row),a
settings_loop:
    ld a,(v_font)
    push af
    xor a
    ld (v_font),a               ; chrome in the dense font
    ld hl,STR_APP_SET
    call ui_begin_id
    xor a
    ld (v_ui1),a               ; row being drawn
settings_draw:
    ld a,(v_ui1)
    ld b,a
    add a,a
    ld c,a
    add a,a
    add a,c                     ; row * 6
    add a,14
    ld c,a                      ; y
    ld a,b
    add a,a
    ld e,a
    ld d,0
    ld hl,settings_labels
    add hl,de
    ld e,(hl)
    inc hl
    ld d,(hl)
    ex de,hl
    call tr
    ld b,0
    push bc
    call S_PUTS
    pop bc
    ld b,13
    ld a,(v_ui1)
    call settings_value         ; draws the value at (B=13, C=y)
    ld a,(v_ui1)
    ld d,a
    ld a,(v_row)
    cp d
    jr nz,settings_nh
    ld a,d                      ; invert the selected row
    ld c,a
    add a,a
    add a,c
    add a,a
    add a,14
    ld c,a
    ld b,0
    ld d,12
    ld e,6
    call S_GFX_INVERT
settings_nh:
    ld a,(v_ui1)
    inc a
    ld (v_ui1),a
    cp SET_ROWS
    jr c,settings_draw
    ld hl,STR_SET_HELP
    call tr
    ld b,0
    ld c,58
    call S_PUTS
    pop af
    ld (v_font),a
    call S_LCD_BLIT
    call S_WAIT_KEY
    cp K_CLEAR
    ret z
    cp K_ON
    ret z
    cp K_DOWN
    jr nz,settings_up
    ld a,(v_row)
    inc a
    cp SET_ROWS
    jr c,settings_sv
    xor a
settings_sv:
    ld (v_row),a
    jp settings_loop
settings_up:
    cp K_UP
    jr nz,settings_lr
    ld a,(v_row)
    or a
    jr nz,settings_u1
    ld a,SET_ROWS
settings_u1:
    dec a
    jr settings_sv
settings_lr:
    ld c,1
    cp K_RIGHT
    jr z,settings_chg
    ld c,$FF
    cp K_LEFT
    jr z,settings_chg
    ld c,1
    cp K_ENTER
    jp nz,settings_loop
settings_chg:
    ld a,(v_row)
    or a
    jr nz,settings_c1
    ld a,(s_lang)               ; language
    xor 1
    ld (s_lang),a
    call ui_setlang
    jp settings_done
settings_c1:
    cp 1
    jr nz,settings_c2
    ld a,(s_profile)            ; battery profile 0..2
    add a,c
    cp $FF
    jr nz,settings_p1
    ld a,2
settings_p1:
    cp 3
    jr c,settings_p2
    xor a
settings_p2:
    ld (s_profile),a
    jp settings_done
settings_c2:
    cp 2
    jr nz,settings_c3
    ld a,(s_cadj)               ; contrast trim 0..15
    add a,c
    cp $FF
    jr nz,settings_k1
    xor a
settings_k1:
    cp 16
    jr c,settings_k2
    ld a,15
settings_k2:
    ld (s_cadj),a
    jr settings_done
settings_c3:
    cp 3
    jr nz,settings_c4
    ld a,(s_sleepto)            ; calculator sleep 15..255 s, step 15
    ld b,a
    ld a,c
    cp 1
    ld a,b
    jr nz,settings_s1
    add a,15
    jr nc,settings_s2
    ld a,255
    jr settings_s2
settings_s1:
    sub 15
    jr nc,settings_s2
    ld a,15
settings_s2:
    cp 15
    jr nc,settings_s3
    ld a,15
settings_s3:
    ld (s_sleepto),a
    jr settings_done
settings_c4:
    cp 4
    jr nz,settings_c5
    ld a,(s_espsleep)           ; ESP32 sleep: 3..60 x 10 s
    add a,c
    cp 3
    jr nc,settings_e1
    ld a,3
settings_e1:
    cp 61
    jr c,settings_e2
    ld a,60
settings_e2:
    ld (s_espsleep),a
    jr settings_done
settings_c5:
    cp 5
    jr nz,settings_c6
    call S_FONT_TOGGLE
    jr settings_done
settings_c6:
    call S_RTC_GET              ; time: +-1 minute
    ld a,l
    add a,c
    cp $FF
    jr nz,settings_t1
    ld a,59
    ld l,a
    ld a,h
    or a
    jr nz,settings_t0
    ld a,24
settings_t0:
    dec a
    ld h,a
    ld a,l
    jr settings_t3
settings_t1:
    cp 60
    jr c,settings_t3
    xor a
    inc h
    ld l,a
    ld a,h
    cp 24
    jr c,settings_t2
    ld h,0
settings_t2:
    ld a,l
settings_t3:
    ld l,a
    call S_RTC_SET
settings_done:
    call S_SETTINGS_SAVE
    call S_POWER_APPLY
    jp settings_loop

settings_labels: .dw STR_L_LANG,STR_L_BAT,STR_L_CONTRAST,STR_L_SLEEP,STR_L_ESPSLEEP,STR_L_FONT,STR_L_CLOCKSET

settings_value:                 ; A = row, B = col, C = y
    or a
    jr nz,settings_v1
    ld a,(s_lang)
    ld hl,STR_V_ES
    or a
    jr z,settings_vs
    ld hl,STR_V_EN
    jr settings_vs
settings_v1:
    cp 1
    jr nz,settings_v2
    ld a,(s_profile)
    add a,a
    ld e,a
    ld d,0
    ld hl,STR_V_PROF0
    add hl,de
    jr settings_vs
settings_v2:
    cp 2
    jr nz,settings_v3
    ld a,(s_cadj)
    ld l,a
    ld h,0
    jp S_PRINT_U16
settings_v3:
    cp 3
    jr nz,settings_v4
    ld a,(s_sleepto)
    ld l,a
    ld h,0
    jp S_PRINT_U16
settings_v4:
    cp 4
    jr nz,settings_v5
    ld a,(s_espsleep)
    ld e,a
    ld d,0
    ld hl,0
    ld a,10
settings_v4l:
    add hl,de
    dec a
    jr nz,settings_v4l
    jp S_PRINT_U16
settings_v5:
    cp 5
    jr nz,settings_v6
    ld a,(v_font)
    ld hl,STR_V_FONTS
    or a
    jr z,settings_vs
    ld hl,STR_V_FONTB
    jr settings_vs
settings_v6:
    push bc
    call S_RTC_GET
    ld a,h
    ld (v_ui0),a
    ld a,l
    ld (v_ui2),a
    pop bc
    ld hl,NUMBUF
    ld a,(v_ui0)
    call two_digits
    ld (hl),':'
    inc hl
    ld a,(v_ui2)
    call two_digits
    ld (hl),0
    ld hl,NUMBUF
    jp S_PUTS
settings_vs:
    call tr
    jp S_PUTS

two_digits:                     ; A -> two ASCII digits at (HL), HL advanced
    push bc
    ld b,'0'
two_digits_t:
    cp 10
    jr c,two_digits_o
    sub 10
    inc b
    jr two_digits_t
two_digits_o:
    ld (hl),b
    inc hl
    add a,'0'
    ld (hl),a
    inc hl
    pop bc
    ret

; ---- dashboard, clock, info ---------------------------------------------------------------------------
; Live screens refresh once per second while polling the keyboard every ~28 ms (HALT between polls).
app_dash:
    xor a
    ld (v_ui3),a
dash_loop:
    ld a,(v_font)
    push af
    xor a
    ld (v_font),a
    ld hl,STR_APP_DASH
    call ui_begin_id
    ; battery
    ld hl,STR_D_BAT
    ld a,0
    call dash_label
    ld a,(v_batlvl)
    add a,a
    ld e,a
    ld d,0
    ld hl,status_pct_ui
    add hl,de
    ld e,(hl)
    inc hl
    ld d,(hl)
    ex de,hl
    ld b,13
    ld c,14
    call S_PUTS
    ; cpu
    ld hl,STR_D_CPU
    ld a,1
    call dash_label
    in a,(P_SPEED)
    and 3
    ld hl,txt_15
    jr nz,dash_cpu
    ld hl,txt_6
dash_cpu:
    ld b,13
    ld c,20
    call S_PUTS
    ; ram
    ld hl,STR_D_RAM
    ld a,2
    call dash_label
    ld hl,txt_ram
    ld b,13
    ld c,26
    call S_PUTS
    ; esp
    ld hl,STR_D_ESP
    ld a,3
    call dash_label
    ld a,(v_esp)
    add a,a
    ld e,a
    ld d,0
    ld hl,esp_names
    add hl,de
    ld e,(hl)
    inc hl
    ld d,(hl)
    ex de,hl
    ld b,13
    ld c,32
    call S_PUTS
    ld a,(v_esp)
    or a
    jr z,dash_noesp
    ld a,(v_rssi)
    ld l,a
    ld h,0
    ld b,18
    ld c,32
    call S_PRINT_U16
dash_noesp:
    ; uptime
    ld hl,STR_D_UP
    ld a,4
    call dash_label
    ld hl,(v_sec)
    ld b,13
    ld c,38
    call S_PRINT_U16
    ; halts / sleeps
    ld hl,STR_D_HALT
    ld a,5
    call dash_label
    ld hl,(v_halts)
    ld b,13
    ld c,44
    call S_PRINT_U16
    ld hl,STR_D_SLEEPS
    ld a,6
    call dash_label
    ld hl,(v_sleeps)
    ld b,13
    ld c,50
    call S_PRINT_U16
    ld hl,STR_D_KEYS
    call tr
    ld b,0
    ld c,58
    call S_PUTS
    pop af
    ld (v_font),a
    call S_LCD_BLIT
    ld b,36                     ; ~1 s of 28 ms polls
dash_poll:
    push bc
    call S_KEY_POLL
    pop bc
    or a
    jr nz,dash_key
    push bc
    ld bc,3
    call S_TASK_SLEEP
    pop bc
    djnz dash_poll
    jp dash_loop
dash_key:
    cp K_CLEAR
    ret z
    cp K_ON
    ret z
    cp K_ENTER
    jp nz,dash_loop
    ld a,(v_esp)                ; ENTER: force ESP32 sleep / wake
    or a
    jr z,dash_wake
    call S_LINK_ESP_SLEEP
    jp dash_loop
dash_wake:
    ld a,CMD_STATUS
    ld hl,INBUF
    ld b,0
    call S_LINK_REQUEST
    jp dash_loop

dash_label:                     ; HL = STR id, A = line -> draws the label at col 0
    push af
    call tr
    pop af
    ld b,a
    add a,a
    ld c,a
    add a,a
    add a,c                     ; line*6
    add a,14
    ld c,a
    ld b,0
    jp S_PUTS

status_pct_ui: .dw dp0,dp1,dp2,dp3
dp0: .db "LOW",0
dp1: .db "40%",0
dp2: .db "70%",0
dp3: .db "100%",0
txt_15: .db "15 MHZ",0
txt_6:  .db "6 MHZ",0
txt_ram: .db "8 X 16K",0
esp_names: .dw en0,en1,en2
en0: .db "ZZZ (SLEEP)",0
en1: .db "ESP AWAKE",0
en2: .db "WIFI RSSI",0

; ---- clock -------------------------------------------------------------------------------------------------
app_clock:
clock_loop:
    ld hl,STR_C_TITLE
    call ui_begin_id
    ld a,(v_font)
    push af
    ld a,1
    ld (v_font),a               ; big digits: 6x8 font
    call S_RTC_GET
    ld a,h
    ld (v_ui0),a
    ld a,l
    ld (v_ui2),a
    ld hl,NUMBUF
    ld a,(v_ui0)
    call two_digits
    ld (hl),':'
    inc hl
    ld a,(v_ui2)
    call two_digits
    ld (hl),':'
    inc hl
    ld a,(v_clks)
    call two_digits
    ld (hl),0
    ld hl,NUMBUF
    ld b,4
    ld c,26
    call S_PUTS
    pop af
    ld (v_font),a
    xor a
    ld (v_ui1),a
    ld hl,STR_C_SYNC
    call tr
    ld b,0
    ld c,46
    call S_PUTS_SMALL
    ld hl,STR_C_SET
    call tr
    ld b,0
    ld c,52
    call S_PUTS_SMALL
    call S_LCD_BLIT
    ld b,36
clock_poll:
    push bc
    call S_KEY_POLL
    pop bc
    or a
    jr nz,clock_key
    push bc
    ld bc,3
    call S_TASK_SLEEP
    pop bc
    djnz clock_poll
    jr clock_loop
clock_key:
    cp K_CLEAR
    ret z
    cp K_ON
    ret z
    cp K_ENTER
    jr z,clock_sync
    ld c,1
    cp K_PLUS
    jr z,clock_adj
    ld c,$FF
    cp K_MINUS
    jr z,clock_adj
    jp clock_loop
clock_adj:
    call S_RTC_GET
    ld a,l
    add a,c
    cp $FF
    jr nz,clock_a1
    ld a,59
    jr clock_a3
clock_a1:
    cp 60
    jr c,clock_a3
    xor a
clock_a3:
    ld l,a
    call S_RTC_SET
    jp clock_loop
clock_sync:                     ; NTP through the ESP32: the reply frame sets the RTC (CMD_TIME)
    ld a,CMD_TIME
    ld hl,INBUF
    ld b,0
    call S_LINK_REQUEST
    jp clock_loop

; ---- info ----------------------------------------------------------------------------------------------------
app_info:
    ld hl,STR_APP_INFO
    call ui_begin_id
    ld hl,info1
    ld b,0
    ld c,14
    call S_PUTS_SMALL
    ld hl,info2
    ld b,0
    ld c,20
    call S_PUTS_SMALL
    ld hl,info3
    ld b,0
    ld c,26
    call S_PUTS_SMALL
    ld hl,info4
    ld b,0
    ld c,32
    call S_PUTS_SMALL
    ld hl,info5
    ld b,0
    ld c,38
    call S_PUTS_SMALL
    ld hl,info6
    ld b,0
    ld c,44
    call S_PUTS_SMALL
    jp ui_wait_any
info1: .db "SUPER-OS 0.1  Z80 15 MHZ",0
info2: .db "TI-83+ SILVER EDITION",0
info3: .db "KERNEL: 1 FLASH PAGE",0
info4: .db "PREEMPTIVE MULTITASKING",0
info5: .db "ZX0 FS  T9  ES/EN",0
info6: .db "SUPERLINK + ESP32-S3 AI",0

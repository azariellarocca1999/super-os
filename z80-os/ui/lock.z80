; =============================================================================
; Lock settings app.  The PIN screen itself (lock_pin_read / lock_unlock) lives in the kernel (kernel/lock.z80) so it also works when the
; calculator wakes up inside an app or a game.
;   s_lock 0 = off, 1 = PIN after every sleep and at boot, 2 = exam mode: the launcher refuses the items flagged $80 (games, AI, network,
;   reference tools, notes, settings, diagnostics).  No back door inside the OS: a forgotten PIN is cleared by flashing a different build (kernel/lock.z80, lock_build_check).
; =============================================================================
app_lock:
    ld a,(s_lock)
    or a
    call nz,S_LOCK_UNLOCK       ; changing the lock needs the PIN
lk_menu:
    ld hl,STR_APP_LOCK
    call ui_begin_id
    ld hl,STR_LK_1
    ld c,14
    call lk_line
    ld hl,STR_LK_2
    ld c,22
    call lk_line
    ld hl,STR_LK_3
    ld c,30
    call lk_line
    ld hl,STR_LK_4
    ld c,38
    call lk_line
    ld a,(s_lock)               ; state line: STR_LK_S0 + 2 * mode
    add a,a
    ld l,a
    ld h,0
    ld de,STR_LK_S0
    add hl,de
    ld c,50
    call lk_line
    call ui_wait_any
    cp K_1
    jr z,lk_pin
    cp K_2
    jr z,lk_exam
    cp K_3
    jr z,lk_off
    cp K_4
    jr z,lk_now
    ret
lk_line:                        ; HL = STR id, C = y
    call tr
    ld b,0
    jp S_PUTS_SMALL
lk_pin:
    ld a,1
    jr lk_set
lk_exam:
    ld a,2
lk_set:
    ld (v_ui1),a
    ld hl,STR_PIN_NEW
    call tr
    call S_LOCK_PIN_READ
    ret c
    push hl
    ld hl,STR_PIN_AGAIN
    call tr
    call S_LOCK_PIN_READ
    pop de
    ret c
    or a
    sbc hl,de
    jr z,lk_same
    ld hl,STR_PIN_DIFF
    call ui_message
    jr lk_menu
lk_same:
    ld (s_pin),de
    ld a,(v_ui1)
    ld (s_lock),a
    call S_SETTINGS_SAVE
    ld hl,STR_O_DONE
    jp ui_message
lk_off:
    xor a
    ld (s_lock),a
    call S_SETTINGS_SAVE
    jp lk_menu
lk_now:
    ld a,(s_lock)
    or a
    jp z,lk_menu
    call S_LOCK_UNLOCK
    jp lk_menu

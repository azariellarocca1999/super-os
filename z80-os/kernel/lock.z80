; =============================================================================
; Screen lock (kernel, so it works wherever the calculator wakes up: launcher, an app, a game).
;   s_lock 0 = off, 1 = PIN after every sleep and at boot, 2 = exam mode (same, and the launcher closes the items flagged $80).
;   s_pin = four BCD digits in the settings (flash journal).  NOT cryptographic: it keeps classmates and passers-by out, nothing more.
;   Wrong PIN: a wait of 3 s per failure (60 s at most) before the next try.  A forgotten PIN: flash a different build (lock_build_check clears the lock the first time a new build runs).
;   The screen is drawn over the frame buffer, so the buffer is saved in RAM page 7 ($C200) and put back, and so is the $C000 window.
; =============================================================================
#include "buildid.inc"        ; generated by tools/build.py

lock_build_check:               ; a build that has not run before (OS just installed) drops the lock and its PIN
    ld hl,(s_build)
    ld de,BUILD_ID
    or a
    sbc hl,de
    ret z
    ld hl,BUILD_ID
    ld (s_build),hl
    xor a
    ld (s_lock),a
    ld h,a
    ld l,a
    ld (s_pin),hl
    jp settings_save

pin_keys:   .db K_0,K_1,K_2,K_3,K_4,K_5,K_6,K_7,K_8,K_9

lk_lang:                        ; HL = (ES, EN) pair of strings -> HL = the one of the current language
    ld a,(s_lang)
    or a
    ret z
lkl_l:
    ld a,(hl)
    inc hl
    or a
    jr nz,lkl_l
    ret

lock_pin_read:                  ; HL = title string -> HL = the four digits (BCD), CF = cancelled with CLEAR
    push hl
    xor a
    ld (v_ui0),a                ; digits typed so far
    ld (v_ui2),a
    ld (v_ui3),a                ; the value (16-bit at v_ui2)
lpr_draw:
    pop hl
    push hl
    call ui_begin
    ld hl,NUMBUF                ; "* * _ _"
    ld b,0
lpr_m:
    ld a,(v_ui0)
    cp b
    ld a,'_'
    jr c,lpr_ch
    jr z,lpr_ch
    ld a,'*'
lpr_ch:
    ld (hl),a
    inc hl
    inc b
    ld a,b
    cp 4
    jr z,lpr_end
    ld (hl),' '
    inc hl
    jr lpr_m
lpr_end:
    ld (hl),0
    ld hl,NUMBUF
    ld b,8
    ld c,26
    call puts_small
    call ui_wait_any
    cp K_CLEAR
    jr z,lpr_cancel
    cp K_DEL
    jr z,lpr_del
    ld hl,pin_keys
    ld b,0
lpr_k:
    cp (hl)
    jr z,lpr_dig
    inc hl
    inc b
    ld c,a
    ld a,b
    cp 10
    ld a,c
    jr c,lpr_k
    jp lpr_draw                 ; not a digit
lpr_dig:
    ld hl,(v_ui2)
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld a,l
    or b
    ld l,a
    ld (v_ui2),hl
    ld a,(v_ui0)
    inc a
    ld (v_ui0),a
    cp 4
    jp nz,lpr_draw
    pop de
    ld hl,(v_ui2)
    or a
    ret
lpr_del:
    ld a,(v_ui0)
    or a
    jp z,lpr_draw
    dec a
    ld (v_ui0),a
    ld hl,(v_ui2)
    srl h
    rr l
    srl h
    rr l
    srl h
    rr l
    srl h
    rr l
    ld (v_ui2),hl
    jp lpr_draw
lpr_cancel:
    pop hl
    scf
    ret

lock_unlock:                    ; the PIN screen: only the right PIN gets out of it
    ld a,(v_lockbusy)
    or a
    ret nz                      ; already on screen (the calculator slept again while waiting for the PIN)
    inc a
    ld (v_lockbusy),a
    xor a
    ld (v_lkfail),a
    push hl
    push de
    push bc
    ld a,(v_rampg)              ; keep the $C000 window and the picture of whoever was running
    push af
    ld a,7
    call ram_page
    ld hl,GBUF1
    ld de,$C200
    ld bc,768
    ldir
    ld a,(v_mode)
    push af
    xor a
    call set_mode
lku_ask:
    ld hl,lk_t_enter
    call lk_lang
    call lock_pin_read
    jr c,lku_ask
    ex de,hl
    ld hl,(s_pin)
    or a
    sbc hl,de
    jr z,lku_ok
    ld a,(v_lkfail)             ; wrong: a message and a wait that grows
    cp 20
    jr nc,lku_wait
    inc a
    ld (v_lkfail),a
lku_wait:
    ld hl,lk_t_title
    call lk_lang
    call ui_begin
    ld hl,lk_t_bad
    call lk_lang
    ld b,0
    ld c,26
    call puts_small
    ld hl,lk_t_hold
    call lk_lang
    ld b,0
    ld c,34
    call puts_small
    call lcd_blit
    ld a,(v_lkfail)             ; 3 s per failure
    ld c,a
    add a,a
    add a,c
    ld b,a
lku_sec:
    push bc
    ld bc,108
    call task_sleep
    pop bc
    djnz lku_sec
    jr lku_ask
lku_ok:
    pop af
    call set_mode
    ld hl,$C200
    ld de,GBUF1
    ld bc,768
    ldir
    pop af
    and 7
    call ram_page
    pop bc
    pop de
    pop hl
    xor a
    ld (v_lockbusy),a
    jp lcd_blit

lk_t_title: .db "BLOQUEO",0,"LOCK",0
lk_t_enter: .db "INGRESA EL PIN",0,"ENTER THE PIN",0
lk_t_bad:   .db "PIN INCORRECTO",0,"WRONG PIN",0
lk_t_hold:  .db "ESPERA...",0,"WAIT...",0

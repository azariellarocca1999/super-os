; Math library test stub: page 0 of a throw-away ROM.  Runs the 16-byte records of build/mt_vec.inc
; ([fn.w][mode][pad][12 data bytes]) and stores one 32-byte result record each at $C000:
;   [err][FA 6 bytes][text 25 bytes].  mode 0: FA/FB loaded from data, mode 2: HL = pointer to a text in the data.
#include "math/mathram.inc"
#include "mathjt.inc"
.org $0000
    di
    ld sp,$BFFF
    ld a,1
    out ($20),a                 ; 15 MHz
    ld a,3
    out ($06),a                 ; bank A = flash page 3 (math)
    ld a,$81
    out ($07),a                 ; bank B = RAM page $81
    xor a
    out ($05),a                 ; $C000 window = RAM page 0
    ld ix,mt_vec
    ld iy,$C000
    ld a,(mt_count)
    ld (fx_misc+1),a
mt_loop:
    xor a
    ld (fx_err),a
    ld (fx_str),a
    ld a,(ix+2)
    push ix
    pop hl
    ld de,4
    add hl,de
    cp 2
    jr z,mt_call
    ld de,fx_a
    ld bc,6
    ldir
    ld de,fx_b
    ld bc,6
    ldir
mt_call:
    ld de,mt_ret
    push de
    ld e,(ix+0)
    ld d,(ix+1)
    push de
    ret                         ; "call" the routine through the stack (the ROM cannot be patched)
mt_ret:
    ld a,(fx_err)
    ld (iy+0),a
    push iy
    pop de
    inc de
    ld hl,fx_a
    ld bc,6
    ldir
    ld hl,fx_str
    ld bc,25
    ldir
    ld bc,32
    add iy,bc
    ld bc,32
    add ix,bc
    ld a,(fx_misc+1)
    dec a
    ld (fx_misc+1),a
    jr nz,mt_loop
    ld a,$5A
    ld (fx_misc),a              ; completion marker
mt_done:
    halt
    jr mt_done
#include "mt_vec.inc"

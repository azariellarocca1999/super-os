; DODGE -- original.  4 / 6 = move.  Three blocks rain down; touch one and the round restarts.
; v0 player x, v1/v2 block A x,y, v3/v4 block B, v5/v6 block C, v7 speed phase, v8 score ticks, v9 temps, va frame temp
start:
    cls
    ld v0,28
    ld v1,8
    ld v2,0
    ld v3,30
    ld v4,10
    ld v5,52
    ld v6,20
    ld v8,0
    call dplayer
    call da
    call db
    call dc
    ld va,30
    ld dt,va
sv:
    ld va,dt
    se va,0
    jp sv
loop:
    call dplayer                ; erase everything
    call da
    call db
    call dc
    ld va,4
    sknp va
    call goleft
    ld va,6
    sknp va
    call goright
    add v2,2                    ; blocks fall
    add v4,2
    add v6,2
    ld v9,28
    sub v9,v2
    se vf,0
    jp b1
    ld v2,0
    rnd v1,0x38
b1:
    ld v9,28
    sub v9,v4
    se vf,0
    jp b2
    ld v4,0
    rnd v3,0x38
b2:
    ld v9,28
    sub v9,v6
    se vf,0
    jp b3
    ld v6,0
    rnd v5,0x38
b3:
    call da                     ; blocks first, the player last: a collision flag from the player means a hit
    call db
    call dc
    call dplayer
    se vf,1
    jp tick
    jp start
tick:
    ld va,dt
    se va,0
    jp tick
    ld va,2
    ld dt,va
    jp loop
goleft:
    sne v0,0
    ret
    add v0,0xFE
    ret
goright:
    se v0,56
    add v0,2
    ret
dplayer:
    ld i,pl
    ld v9,29
    drw v0,v9,3
    ret
da:
    ld i,blk
    drw v1,v2,4
    ret
db:
    ld i,blk
    drw v3,v4,4
    ret
dc:
    ld i,blk
    drw v5,v6,4
    ret
pl:
    db 0x7E,0xFF,0xFF
blk:
    db 0xF0,0xF0,0xF0,0xF0
